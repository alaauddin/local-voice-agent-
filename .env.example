DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.110
SQLITE_PATH=
REDIS_URL=redis://127.0.0.1:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
KIOSK_API_KEY=
KIOSK_SESSION_MAX_AGE=86400
VOICE_SOURCE=realtime
VOICE_MODEL=gpt-4o-mini-tts
VOICE_NAME=coral
VOICE_SPEED=1.15
VOICE_WAKE_WORD=يا غروب
VOICE_ACTIVATION_MODE=wake
VOICE_INSTRUCTIONS=Speak warmly and naturally in Arabic only. Never use English words or sentences.
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
REALTIME_API_URL=https://api.openai.com/v1/realtime/calls
REALTIME_SESSION_TIMEOUT=25
REALTIME_LOCAL_SESSION_TTL_SECONDS=900
KIOSK_STALE_REQUEST_SECONDS=180
KIOSK_SQLITE_BUSY_TIMEOUT_MS=30000
REALTIME_VAD_MODE=semantic_vad
REALTIME_VAD_EAGERNESS=high
REALTIME_VAD_THRESHOLD=0.42
REALTIME_VAD_PREFIX_PADDING_MS=250
REALTIME_VAD_SILENCE_MS=420
SAAS_INTEGRATION_URL=
SAAS_INTEGRATION_TOKEN=
SAAS_INTEGRATION_ENABLED=false
SAAS_TENANT_SUBDOMAIN=
SAAS_TIMEOUT_SECONDS=5
# Remote IR command delivery.
REMOTE_COMMAND_TIMEOUT_SECONDS=3
AC_COMMAND_TIMEOUT_SECONDS=5
# Optional shared secret for POST /api/internal/ac-state-sync/.
ESP32_SYNC_TOKEN=
DEVICE_DISCOVERY_TIMEOUT_SECONDS=0.4
DEVICE_DISCOVERY_MAX_HOSTS=1024
DEVICE_DISCOVERY_WORKERS=64
# Required in Docker bridge mode; set this to the server LAN subnet.
DEVICE_DISCOVERY_NETWORK=192.168.1.0/24
DEVICE_DISCOVERY_LOG_LEVEL=INFO
REMOTE_BUTTON_COOLDOWN_SECONDS=1.5
